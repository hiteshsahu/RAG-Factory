# Clang tooling output
compile_commands.json          # regenerated by CMake -DCMAKE_EXPORT_COMPILE_COMMANDS=ON
clang-tidy-fixes.yaml          # run-clang-tidy --export-fixes output
*.clang-tidy-fixes
*.plist                        # clang static analyser (scan-build) reports
.cache/clangd/                 # clangd LSP index cache

